# Supabase project settings -> API. Enable anonymous sign-ins in Authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Anthropic key for the AI Host (server-side only, NEVER prefix with NEXT_PUBLIC).
# If left empty, the AI Host falls back to deterministic narration so the demo still works.
ANTHROPIC_API_KEY=
